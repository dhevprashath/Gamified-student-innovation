# Backend Environment Configuration Example
# Copy to .env and adjust values for your environment.

# Database URL (MySQL / PyMySQL URL)
# Example: mysql+pymysql://username:password@localhost:3306/innoquest
DATABASE_URL=mysql+pymysql://innoquest:innoquest@127.0.0.1:3306/innoquest

# Database individual variables (if DATABASE_URL is unconfigured)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=innoquest
DB_PASSWORD=innoquest
DB_NAME=innoquest

# External LLM API Key (Google Gemini / OpenAI compatible REST API)
AI_API_KEY=your_external_llm_api_key_here
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-3.6-flash
