# Backend Environment Configuration Example
# Copy to .env and adjust values for your environment.

# Database URL (MySQL / PyMySQL URL)
# Example: mysql+pymysql://username:password@localhost:3306/innoquest
DATABASE_URL=mysql+pymysql://innoquest:innoquest@127.0.0.1:3306/innoquest

# Database individual variables (if DATABASE_URL is unconfigured)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=innoquest
DB_PASSWORD=innoquest
DB_NAME=innoquest

# External LLM API Key (Google Gemini / OpenAI compatible REST API)
AI_API_KEY=your_external_llm_api_key_here

# gemini-native = Google generateContent with a strict responseSchema (faster,
# provider-enforced types). openai-compat = /chat/completions, which is what
# OpenAI / Groq / OpenRouter require. "auto" picks native only when AI_API_URL
# is a native Google URL.
AI_PROVIDER=gemini-native
AI_NATIVE_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_MODEL=gemini-3.5-flash-lite

# OpenAI-compatible providers (OpenAI, Groq, OpenRouter, Google shim) instead:
# AI_PROVIDER=openai-compat
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini

# Tried in order after AI_MODEL when a model is unavailable or quota-limited.
AI_MODEL_FALLBACKS=gemini-3.1-flash-lite-preview,gemini-flash-lite-latest,gemini-3.6-flash

# Per-request LLM timeout in seconds. Reasoning models can take well over 12s.
AI_TIMEOUT_SECONDS=90

# Optional second provider, used only when every Gemini model above has failed.
# Useful insurance for a live demo: an exhausted or rejected primary key still
# leaves you with a real AI answer. Leave the key empty to disable.
# Groq's free tier moved Llama to Enterprise-only on 2026-08-16; these three
# remain free and also accept strict JSON schemas.
AI_FALLBACK_URL=https://api.groq.com/openai/v1/chat/completions
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# --- Academic references (Crossref / arXiv) ---
# The AI Advisor's References section pulls real papers from Crossref and arXiv,
# so no API key is needed. Setting a contact address opts you into Crossref's
# "polite pool": higher rate limits, so bursts of requests stop returning 429.
# Crossref also throttles un-identified clients fairly aggressively.
CROSSREF_MAILTO=

# --- Similar open-source projects (GitHub) ---
# The References section also searches GitHub for similar projects. Unauthenticated
# search is limited to 10 requests per minute; each query is cached for an hour
# so normal use stays well inside that. A free token raises the limit to 30/min.
GITHUB_TOKEN=
