# InnoQuest backend configuration template.
# Copy to .env and fill in real values. Never commit .env.
# All values can also be provided as real environment variables (they win over .env).

# --- Application ---
APP_NAME=InnoQuest API
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
# Default (sample): SQLite file at backend/innoquest.db - zero setup, no MySQL needed.
# Create/refresh it with:  alembic upgrade head
DATABASE_URL=sqlite:///./innoquest.db
#
# For MySQL 8.0, clear DATABASE_URL and set DB_* instead, e.g.
# DATABASE_URL=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=innoquest
# DB_PASSWORD=innoquest
# DB_NAME=innoquest
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=innoquest
DB_PASSWORD=innoquest
DB_NAME=innoquest

# --- Security / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=8

# --- Authentication cookie (HttpOnly) ---
AUTH_COOKIE_NAME=innoquest_session
# True in production (HTTPS only)
AUTH_COOKIE_SECURE=false
# lax | strict | none
AUTH_COOKIE_SAMESITE=lax

# --- CORS (JSON list) ---
# Local Vite dev servers + local API docs origin.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Logging ---
LOG_LEVEL=INFO

# --- Rate limiting (requests per minute per client) ---
RATE_LIMIT_PER_MINUTE=120
